{
  "version": "1.5.4",
  "description": "Traycer desktop app",
  "homepage": "https://traycer.ai",
  "license": "MIT",
  "notes": "Release notes: https://github.com/traycerai/traycer/releases/tag/desktop-v1.5.4",
  "architecture": {
    "64bit": {
      "url": "https://github.com/traycerai/traycer/releases/download/desktop-v1.5.4/traycer-desktop-windows-x64.exe#/dl.7z",
      "hash": "50e1c155db508f2bd6c741fc47ab5d8183647ca830b6e7af3365bdb51d313abd"
    }
  },
  "installer": {
    "script": [
      "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
      "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Force -Recurse -ErrorAction SilentlyContinue",
      "Set-Content -Path \"$dir\\resources\\package-type\" -Value 'scoop' -NoNewline -Encoding ascii"
    ]
  },
  "uninstaller": {
    "script": [
      "if ($cmd -eq 'uninstall') {",
      "  $cli = $null",
      "  try { $raw = Get-Content -Raw -LiteralPath (Join-Path $env:USERPROFILE '.traycer\\cli\\manifest.json') -ErrorAction Stop; if ($raw.TrimStart().StartsWith('{')) { $cli = ConvertFrom-Json $raw } } catch {}",
      "  if (-not (($cli -is [System.Management.Automation.PSCustomObject]) -and ($cli.source -is [string]) -and ($cli.source -ceq 'desktop'))) { return }",
      "  try {",
      "    $s = New-Object -ComObject Schedule.Service",
      "    $s.Connect()",
      "    $task = $null",
      "    $gone = $false",
      "    try { $task = $s.GetFolder('\\').GetTask('\\Traycer\\Host') } catch { $e = $_.Exception; if ($e.InnerException) { $e = $e.InnerException }; $gone = ($e.HResult -eq -2147024894) -or ($e.HResult -eq -2147024893) }",
      "    $mine = $false",
      "    if ($task) {",
      "      $u = [string]$task.Definition.Principal.UserId",
      "      if ($u -notmatch '^S-1-[0-9]+(-[0-9]+)+$') { $u = (New-Object System.Security.Principal.NTAccount($u)).Translate([System.Security.Principal.SecurityIdentifier]).Value }",
      "      $mine = $u -ieq [System.Security.Principal.WindowsIdentity]::GetCurrent().User.Value",
      "    }",
      "    if ($mine) {",
      "      schtasks /End /TN '\\Traycer\\Host' | Out-Null",
      "      schtasks /Delete /TN '\\Traycer\\Host' /F | Out-Null",
      "    }",
      "    if ($mine -or $gone) {",
      "      $folder = $s.GetFolder('\\Traycer')",
      "      if ((@($folder.GetTasks(1)).Count -eq 0) -and (@($folder.GetFolders(0)).Count -eq 0)) { $s.GetFolder('\\').DeleteFolder('Traycer', 0) }",
      "    }",
      "  } catch {}",
      "  Remove-Item \"$env:USERPROFILE\\.traycer\\cli\\host-start-hidden.vbs\" -Force -ErrorAction SilentlyContinue",
      "}"
    ]
  },
  "shortcuts": [
    [
      "Traycer.exe",
      "Traycer"
    ]
  ],
  "checkver": {
    "url": "https://api.github.com/repos/traycerai/traycer/releases?per_page=100",
    "regex": "\"tag_name\":\\s*\"desktop-v([\\d.]+)\""
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/traycerai/traycer/releases/download/desktop-v$version/traycer-desktop-windows-x64.exe#/dl.7z"
      }
    }
  }
}
